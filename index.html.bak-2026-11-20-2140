      // let omega = 0.05; // Lento --> 0.01 | Normal --> 0.05 | Rápido --> 0.09
      // Fase inicial SOMENTE do marcador "Estado Atual" do gráfico P-V: meio da curva vermelha (π a 3π/2).
      // O motor e os ângulos (angle, angle_one/two/five/six_engine) continuam iniciando em π.
      const MARKER_START_ANGLE = (5 * Math.PI) / 4;
      const MARKER_PHASE_OFFSET = MARKER_START_ANGLE - Math.PI; // π/4, aplicado apenas ao marcador
      let angle = Math.PI;
      let angle_one_engine = (3 * Math.PI) / 2; // (3 * Math.PI) / 2 --> Máximo || Math.PI / 2 --> Mínimo
      let angle_two_engine = Math.PI / 2;
      let angle_five_engine = (3 * Math.PI) / 2;
