    <title>Motor Stirling: Gama</title>
    <style>
      /* =====================================================================
         ÍNDICE DO CSS
         1. Variáveis (cores, tipografia, medidas)      6. Controles (play, reload, temperaturas, trabalho)
         2. Base / reset                                7. Barra inferior e menu de materiais
         3. Estrutura da página (grid)                  8. Breakpoints: ≤1200, ≤1000, retrato/≤700, ≤400
         4. Cabeçalho                                   9. Ajustes para toque e fallback sem container queries
         5. Painéis (motor e gráfico)
         ===================================================================== */

      /* ------------------ 1. Variáveis ----------------- */
      :root {
        /* Cores: o par frio (azul) / quente (laranja) é o motivo visual do projeto */
        --cold: rgb(30, 144, 255);
        --hot: rgb(255, 111, 0);
        --ink: #1d2433;
        --ink-soft: #4a5468;
        --line: #dde2ea;
        --surface: #ffffff;
        --dark: rgb(69, 68, 67);
        --nav-bg: #0e1116;
        --focus: rgba(30, 144, 255, 0.6);

        /* Tipografia */
        --font-sans:
          "Inter", system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;

        /* Forma */
        --radius: 12px;
        --radius-sm: 6px;
        --shadow-sm:
          0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.1);
        --btn-shadow:
          inset 2px 2px 5px 2px rgba(226, 222, 218, 0.5),
          inset -2px -2px 5px 2px rgba(0, 0, 0, 0.5);
        --btn-shadow-pressed:
          inset 0 0 5px 8px rgba(226, 222, 218, 0.4),
          inset 0 0 5px 8px rgba(226, 222, 218, 0.4);

        /* Medidas que mudam nos breakpoints */
        --pad: clamp(8px, 1.4vw, 20px);
        --footer-h: clamp(48px, 8vh, 72px);
        --btn-sm: 34px; /* rewind, step, reload */
        --btn-lg: 54px; /* play / pause */
        --arrow-size: 14px; /* botões ▲/▼ das temperaturas */
        --temp-w: 120px; /* largura do valor de temperatura */
        --eng-cap: clamp(560px, 35vw, 700px); /* largura máxima do Canvas do motor */
        --chart-cap: clamp(560px, 42vw, 720px); /* largura máxima do gráfico P-V */
        --chart-ratio: 3 / 2; /* proporção largura/altura do gráfico */
      }

      /* ------------------ 2. Base ----------------- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* O Bootstrap define margens em p/h1/ul com seletor de elemento; este reset vem depois e prevalece */
      p,
      h1,
      ul {
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-sans);
        color: var(--ink);
        -webkit-text-size-adjust: 100%;
      }

      body {
        background: var(--surface);
        overflow-x: hidden;
      }

      button,
      input {
        font-family: inherit;
      }

      button:focus-visible,
      a:focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 2px;
      }

      /* ------------------ 3. Estrutura da página ----------------- */
      /* Telas largas: painel de altura fixa (cabeçalho / palco / barra inferior).
         Telas estreitas: a página rola na vertical (ver breakpoints). */
      .container-box {
        width: 100%;
        height: 100vh;
        height: 100dvh;
        min-height: 560px;
        display: grid;
        /* minmax(0, 1fr): a coluna não cresce com o conteúdo (ex.: o Highcharts guarda a largura anterior
           até o reflow) — sem isso o layout não encolheria depois de reduzir a janela */
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr) auto;
        overflow-x: clip;
      }

      .stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) auto;
        min-width: 0;
        min-height: 0;
      }

      .panels {
        display: grid;
        /* levemente mais largo para o motor: mantém o desenho na escala de referência (0,75) em notebooks */
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: var(--pad);
        padding: var(--pad) var(--pad) 0;
        min-height: 0;
      }

      /* ------------------ 4. Cabeçalho (título) ----------------- */
      .header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px var(--pad) 11px;
        background:
          linear-gradient(
            90deg,
            rgba(30, 144, 255, 0.16) 0%,
            rgba(30, 144, 255, 0) 38%,
            rgba(255, 111, 0, 0) 62%,
            rgba(255, 111, 0, 0.18) 100%
          ),
          var(--surface);
      }

      /* Filete frio → quente sob o título */
      .header::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        background: linear-gradient(
          90deg,
          var(--cold) 0%,
          rgba(30, 144, 255, 0.35) 40%,
          rgba(255, 111, 0, 0.35) 60%,
          var(--hot) 100%
        );
      }

      .title-menu {
        min-width: 0;
        display: flex;
        justify-content: center;
      }

      .app-title {
        font-size: clamp(1.1rem, 0.8rem + 1.3vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.2;
        color: var(--ink);
        text-align: center;
        text-wrap: balance;
      }

      .title-sub {
        display: inline-block;
        font-weight: 500;
        color: var(--ink-soft);
      }

      /* ------------------ 5. Painéis ----------------- */
      .engine-panel,
      .chart-panel {
        min-width: 0;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        container-type: size; /* habilita as unidades cqw/cqh dos filhos */
      }

      /* Motor: [coluna das temperaturas] + [Canvas]. O Canvas mantém a proporção do desenho
         (560 × 440) e cabe no painel sem distorção; --eng-w/--eng-h são usados pelo Canvas e
         pela coluna de temperaturas para ficarem alinhados. */
      .engine-stage {
        --temps-w: calc(var(--temp-w) + var(--arrow-size) + 12px);
        --eng-w: min(100cqw - var(--temps-w), 100cqh * 560 / 440, var(--eng-cap));
        --eng-h: calc(var(--eng-w) * 440 / 560);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .engine-stage canvas {
        flex: 0 0 auto;
        display: block;
        width: var(--eng-w);
        height: var(--eng-h);
      }

      .temperature-controls {
        position: relative;
        flex: 0 0 var(--temps-w);
        width: var(--temps-w);
        height: var(--eng-h);
      }

      /* Gráfico P-V: o Highcharts preenche este contêiner (proporção fixa) e se redimensiona com ele */
      #circleStirling {
        width: min(100cqw, 100cqh * 3 / 2, var(--chart-cap));
        aspect-ratio: var(--chart-ratio);
        max-width: 100%;
      }

      /* ------------------ 6. Controles ----------------- */
      .controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        column-gap: var(--pad);
        padding: 10px var(--pad) 12px;
      }

      /* Os dois blocos do .button-box entram direto na grade de .controls */
      .button-box {
        display: contents;
      }

      .button-box-principal {
        grid-column: 2;
        grid-row: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
      }

      .button-box-reload {
        grid-column: 3;
        grid-row: 1;
        justify-self: end;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* Botões redondos (rewind, play, step, reload) */
      .button-rewind,
      .button-play,
      .button-step,
      .button-reload {
        flex: 0 0 auto;
        border-radius: 50%;
        border: 1px solid rgba(69, 68, 67, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: var(--dark);
        color: #f5f5f4;
        box-shadow: var(--btn-shadow);
        transition: filter 0.15s ease;
      }

      .button-rewind,
      .button-step,
      .button-reload {
        width: var(--btn-sm);
        height: var(--btn-sm);
      }

      .button-play {
        width: var(--btn-lg);
        height: var(--btn-lg);
      }

      .button-reload {
        background-color: var(--hot);
        color: #fff;
        border-color: rgba(69, 68, 67, 0.5);
      }

      .button-rewind:hover,
      .button-play:hover,
      .button-step:hover,
      .button-reload:hover {
        filter: brightness(1.18);
      }

      .button-rewind:active,
      .button-play:active,
      .button-step:active,
      .button-reload:active {
        box-shadow: var(--btn-shadow-pressed);
      }

      .button-rewind:disabled,
      .button-step:disabled {
        cursor: not-allowed;
        filter: none;
      }

      .rewind,
      .step,
      .reload {
        width: 70%;
        height: 70%;
      }

      .play,
      .pause {
        width: 82%;
        height: 82%;
      }

      /* Entradas de temperatura (fonte fria / fonte quente) */
      .cold-temperature,
      .hot-temperature {
        display: flex;
        justify-content: center;
        align-items: flex-end;
      }

      /* Telas largas: ficam à esquerda do motor, na altura da placa fria e da placa quente.
         As porcentagens são posições no desenho do Canvas (placa fria ≈ 64 %, placa quente ≈ 89 %
         da altura); 18px é a altura do rótulo e --arrow-size a metade do valor. */
      .temperature-controls .cold-temperature,
      .temperature-controls .hot-temperature {
        position: absolute;
        right: 0;
      }

      .temperature-controls .cold-temperature {
        top: calc(63.7% - 18px - var(--arrow-size));
      }

      .temperature-controls .hot-temperature {
        top: calc(89.3% - 18px - var(--arrow-size));
      }

      .text-input-cold-temperature,
      .text-input-hot-temperature {
        width: var(--temp-w);
      }

      .text-input-cold-temperature p:first-child,
      .text-input-hot-temperature p:first-child {
        font-size: 14px;
        font-weight: 700;
        line-height: 18px;
        color: var(--ink);
        white-space: nowrap;
      }

      .cold-source,
      .hot-source {
        height: calc(2 * var(--arrow-size));
        display: flex;
        align-items: center;
        padding: 0 8px;
        border: 1px solid rgba(0, 0, 0, 0.7);
        border-radius: var(--radius-sm);
        color: #000;
        font-size: 14px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }

      .cold-source {
        background-color: var(--cold);
      }

      .hot-source {
        background-color: var(--hot);
      }

      .cold-temperature button,
      .hot-temperature button {
        width: var(--arrow-size);
        height: var(--arrow-size);
        background-color: transparent;
        border: transparent;
        border-radius: 3px;
        color: var(--ink);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cold-temperature-buttons,
      .hot-temperature-buttons {
        display: flex;
        flex-direction: column;
      }

      .cold-temperature button:hover:not(:disabled),
      .hot-temperature button:hover:not(:disabled) {
        color: #0b5ed7;
      }

      .cold-temperature button:disabled,
      .hot-temperature button:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .cold-up,
      .cold-down,
      .hot-up,
      .hot-down {
        width: 100%;
        height: auto;
      }

      /* Leituras de trabalho: três colunas (rótulo | valor | unidade) alinhadas entre as duas linhas */
      .work-boxes {
        grid-column: 3;
        grid-row: 1;
        justify-self: start;
        display: grid;
        grid-template-columns: auto auto auto;
        align-items: center;
        column-gap: 6px;
        row-gap: 6px;
      }

      .work-box {
        display: contents;
      }

      .work-box p {
        font-weight: 700;
        color: var(--ink);
        white-space: nowrap;
      }

      .work-box p:first-child {
        text-align: right;
      }

      .work {
        min-width: 5.4em;
        padding: 4px 8px;
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.7);
        border-radius: var(--radius-sm);
        background-color: rgb(226, 224, 232);
        font-variant-numeric: tabular-nums;
      }

      /* ------------------ 7. Barra inferior ----------------- */
      .navbar-bottom-box {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px 16px;
        min-height: var(--footer-h);
        padding: 5px 15px;
        background-color: var(--nav-bg);
      }

      /* Filete frio → quente no topo da barra */
      .navbar-bottom-box::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--cold), var(--hot));
        opacity: 0.85;
      }

      .navbar-bottom-box p,
      .navbar-bottom-box a,
      .materials-toggle {
        color: #fff;
        text-decoration: none;
        font-size: clamp(14px, 1.4vw, 20px);
      }

      .navbar-bottom-options > ul {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px 15px;
        list-style: none;
      }

      .navbar-bottom-options > ul > li {
        position: relative;
      }

      .navbar-bottom-options > ul > li > a {
        display: inline-block;
        padding: 6px 2px;
        border-bottom: 2px solid transparent;
      }

      .navbar-bottom-options > ul > li > a:hover {
        border-bottom-color: var(--hot);
      }

      /* Menu "Materiais" (abre para cima; usa o dropdown do Bootstrap já carregado) */
      .materials-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        font-family: inherit;
        line-height: 1.3;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 999px;
      }

      .materials-toggle:hover,
      .materials-toggle.show {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.55);
      }

      .materials-toggle .mi-icon {
        width: 1.1em;
        height: 1.1em;
        flex: 0 0 auto;
      }

      .dropdown-menu.materials-menu {
        --bs-dropdown-min-width: 15rem;
        --bs-dropdown-padding-y: 6px;
        --bs-dropdown-border-color: var(--line);
        --bs-dropdown-border-radius: 10px;
        --bs-dropdown-box-shadow: 0 8px 24px rgba(16, 24, 40, 0.18);
        --bs-dropdown-link-active-bg: rgba(30, 144, 255, 0.12);
        font-family: var(--font-sans);
        max-width: min(20rem, calc(100vw - 24px));
      }

      .materials-menu .dropdown-header {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .dropdown-menu .materials-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
      }

      .materials-item:hover,
      .materials-item:focus-visible {
        background: rgba(30, 144, 255, 0.1);
        color: var(--ink);
      }

      .materials-item .mi-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 auto;
        color: var(--cold);
      }

      .materials-item .mi-ext {
        width: 16px;
        height: 16px;
        margin-left: auto;
        flex: 0 0 auto;
        color: var(--ink-soft);
      }

      /* ------------------ 8. Breakpoints ----------------- */

      /* ≤ 1200px: notebooks pequenos e janelas reduzidas — só espaçamentos e tamanhos */
      @media (max-width: 1200px) {
        :root {
          --pad: 12px;
          --temp-w: 108px;
          --eng-cap: 560px;
          --chart-cap: 600px;
        }

        .panels {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .text-input-cold-temperature p:first-child,
        .text-input-hot-temperature p:first-child {
          font-size: 13px;
        }

        .engine-panel,
        .chart-panel {
          padding: 8px;
        }
      }

      /* ≤ 1000px: a página passa a rolar; as temperaturas saem do lado do motor e
         os controles ocupam mais de uma linha */
      @media (max-width: 1000px) {
        :root {
          --footer-h: 52px;
          --temp-w: 120px;
          --chart-ratio: 4 / 3;
        }

        .container-box {
          height: auto;
          min-height: 100vh;
          min-height: 100dvh;
        }

        .stage {
          display: flex;
          flex-direction: column;
        }

        .engine-panel,
        .chart-panel {
          container-type: normal;
          padding: 10px;
        }

        .engine-panel {
          display: block;
        }

        .engine-stage {
          --eng-w: min(100%, var(--eng-cap));
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 10px;
        }

        .engine-stage canvas {
          width: var(--eng-w);
          height: auto;
          aspect-ratio: 560 / 440;
        }

        .temperature-controls {
          order: 2;
          position: static;
          flex: none;
          width: 100%;
          height: auto;
          display: flex;
          justify-content: center;
          flex-wrap: wrap;
          gap: 12px 28px;
        }

        .temperature-controls .cold-temperature,
        .temperature-controls .hot-temperature {
          position: static;
        }

        #circleStirling {
          width: min(100%, var(--chart-cap));
        }

        .controls {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          gap: 14px 28px;
          padding: 14px var(--pad) 16px;
        }

        .button-box {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 20px;
          width: 100%;
        }

        .button-box-principal,
        .button-box-reload {
          grid-column: auto;
        }

        .work-boxes {
          justify-self: auto;
        }
      }

      /* 701–1000px em paisagem: motor e gráfico lado a lado; gráfico mais alto para caber a legenda
         e play + leituras de trabalho na mesma linha, quando couberem */
      @media (min-width: 701px) and (max-width: 1000px) and (orientation: landscape) {
        :root {
          --chart-ratio: 1 / 1;
        }

        .button-box {
          width: auto;
        }
      }

      /* Retrato (tablets em pé) e telas ≤ 700px: uma coluna, na ordem
         motor → temperaturas → play → gráfico → trabalho */
      @media (max-width: 1000px) and (orientation: portrait), (max-width: 700px) {
        .stage {
          gap: 14px;
          padding: 12px var(--pad);
        }

        .panels,
        .controls {
          display: contents;
        }

        .engine-panel {
          order: 1;
        }

        .button-box {
          order: 2;
        }

        .chart-panel {
          order: 3;
        }

        .work-boxes {
          order: 4;
          align-self: center;
        }
      }

      /* ≤ 700px: celulares — alvos de toque maiores, barra inferior em duas linhas */
      @media (max-width: 700px) {
        :root {
          --btn-sm: 44px;
          --btn-lg: 64px;
          --arrow-size: 24px;
          --temp-w: 132px;
          --chart-ratio: 4 / 3;
          --footer-h: 0px;
        }

        .stage {
          padding-inline: 10px;
        }

        .button-box {
          gap: 18px;
        }

        .button-box-principal {
          gap: 14px;
        }

        .text-input-cold-temperature p:first-child,
        .text-input-hot-temperature p:first-child {
          font-size: 13px;
        }

        .cold-source,
        .hot-source {
          font-size: 16px;
        }

        .work-boxes {
          font-size: 15px;
        }

        .navbar-bottom-box {
          justify-content: center;
          text-align: center;
          padding: 8px 12px;
        }

        .navbar-bottom-box p {
          flex: 1 1 100%;
          font-size: 13px;
          opacity: 0.85;
        }

        .navbar-bottom-box a,
        .materials-toggle {
          font-size: 15px;
        }

        .navbar-bottom-options > ul {
          justify-content: center;
        }

        .navbar-bottom-options > ul > li > a {
          padding: 10px 4px;
        }
      }

      /* ≤ 480px: gráfico mais alto para não espremer a área de plotagem */
      @media (max-width: 480px) {
        :root {
          --chart-ratio: 9 / 10;
        }
      }

      /* ≤ 400px: celulares compactos (320 / 360 / 375) */
      @media (max-width: 400px) {
        :root {
          --pad: 8px;
          --temp-w: 120px;
        }

        .app-title {
          font-size: 1.1rem;
        }

        .stage {
          padding-inline: 8px;
        }

        .engine-panel,
        .chart-panel {
          padding: 6px;
        }

        .temperature-controls {
          gap: 10px 16px;
        }
      }

      /* ≤ 360px: as duas entradas de temperatura continuam lado a lado e o gráfico fica mais alto */
      @media (max-width: 360px) {
        :root {
          --temp-w: 108px;
          --chart-ratio: 5 / 6;
        }

        .cold-source,
        .hot-source {
          font-size: 15px;
        }
      }

      /* ------------------ 9. Toque e fallback ----------------- */
      /* Telas sensíveis ao toque: botões redondos e ▲/▼ maiores em qualquer largura */
      @media (pointer: coarse) {
        :root {
          --arrow-size: 24px;
          --btn-sm: 44px;
          --btn-lg: 64px;
        }
      }

      /* Navegadores sem container queries (unidades cqw/cqh): o painel usa dimensões simples */
      @supports not (width: 1cqw) {
        .engine-panel,
        .chart-panel {
          container-type: normal;
        }

        .engine-stage {
          --eng-w: min(100%, var(--eng-cap));
        }

        #circleStirling {
          width: min(100%, var(--chart-cap));
        }
      }
    </style>
  </head>

