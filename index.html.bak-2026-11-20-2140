    <script>
      /* =====================================================================================
       * SIMULADOR DO MOTOR STIRLING LTD (TIPO GAMA) — SCRIPT PRINCIPAL
       * =====================================================================================
       * FINALIDADE
       *   Calcular, animar e exibir o ciclo de um motor Stirling tipo gama de baixo diferencial de
       *   temperatura (LTD): desenho animado do mecanismo (Canvas 2D), diagrama P-V (Highcharts) e
       *   trabalho por ciclo (ideal e modelo de Schmidt) em função das temperaturas das fontes.
       *
       * ORGANIZAÇÃO (na ordem em que aparece no código)
       *   BLOCO 1  Interface inicial ........ tooltips Bootstrap dos botões.
       *   BLOCO 2  Canvas ................... contexto 2D, resolução interna e posição do motor.
       *   BLOCO 3  Velocidade da animação ... omega (rad/quadro) em função de ΔT = Th − Tc.
       *   BLOCO 4  Modelo termodinâmico ..... constantes, geometria, volumes, pressões, ciclo ideal,
       *                                       curva de Schmidt, trabalhos e resumo no console.
       *   BLOCO 5  Temperaturas (UI) ........ botões ▲/▼ das fontes fria e quente.
       *   BLOCO 6  Gráfico P-V (Highcharts) . configuração, marcador "Estado Atual", cor do fluido.
       *   BLOCO 7  Ângulo mestre ............ setCycleAngle() e fases do ciclo.
       *   BLOCO 8  updateChart() ............ recálculo + atualização do gráfico a cada mudança de Th/Tc.
       *   BLOCO 9  Animação do Canvas ....... draw(): desenho do motor quadro a quadro.
       *   BLOCO 10 Controles ................ rewind, play/pause, step e reload.
       *   BLOCO 11 Inicialização ............ primeiro desenho e reflow do gráfico.
       *
       * UNIDADES
       *   volumes em cm³ · pressões calculadas em Pa e plotadas em kPa · temperaturas em K ·
       *   quantidade de matéria em mol · ângulos em rad · trabalho em J.
       *
       * FLUXO DE DADOS
       *   botões de temperatura → Tc/Th → updateChart() → recalculateModel() → séries do Highcharts
       *   e leituras W_ciclo,ideal / W_motor,modelo.
       *   draw() (a cada quadro) → setCycleAngle() → angle_six_engine → marcador do gráfico
       *   (updateCyclePointMarker) e pintura do motor, sempre com a MESMA fase.
       *
       * LAYOUT RESPONSIVO
       *   O posicionamento é feito pelo CSS. O Canvas tem resolução interna fixa (BLOCO 2) e é escalado
       *   por CSS sem distorção; o Highcharts acompanha o seu contêiner por reflow (BLOCO 11).
       * ===================================================================================== */

      // =====================================================================================
      // BLOCO 1 — INTERFACE INICIAL
      // =====================================================================================
      //*********************************
      // Carrega os Tooltipes (Mensagens que Aparecem em Cima do Botão  Retroceder, Play, Avançar e Resetar)
      //*********************************
      const tooltipTriggerList = document.querySelectorAll(
        '[data-bs-toggle="tooltip"]',
      );
      [...tooltipTriggerList].map((el) => new bootstrap.Tooltip(el));

      // =====================================================================================
      // BLOCO 2 — CANVAS: CONTEXTO, RESOLUÇÃO INTERNA E POSIÇÃO DO MOTOR
      // =====================================================================================
      // O tamanho EXIBIDO do Canvas é definido pelo CSS (cabe no painel mantendo a proporção 560:440,
      // sem distorção). A resolução INTERNA é fixa: o desenho usa coordenadas lógicas de
      // ENGINE_LOGICAL_WIDTH × ENGINE_LOGICAL_HEIGHT px e o bitmap tem ENGINE_RENDER_SCALE vezes esse
      // tamanho (nitidez em telas de alta densidade). Por isso não é necessário tratar resize/orientação:
      // o navegador reescala o bitmap, e o desenho, os controles e a animação continuam iguais.
      // ctx.setTransform aplica o fator de resolução uma única vez; save()/restore() em draw() o preservam.
      const canvas = document.getElementById("canvas");
      const ctx = canvas.getContext("2d");

      const ENGINE_LOGICAL_WIDTH = 560; // px lógicos (igual a --eng-w0 do CSS: proporção 560:440)
      const ENGINE_LOGICAL_HEIGHT = 440; // px lógicos
      const ENGINE_RENDER_SCALE = 2; // bitmap = 2× o tamanho lógico
      canvas.width = ENGINE_LOGICAL_WIDTH * ENGINE_RENDER_SCALE;
      canvas.height = ENGINE_LOGICAL_HEIGHT * ENGINE_RENDER_SCALE;
      ctx.setTransform(ENGINE_RENDER_SCALE, 0, 0, ENGINE_RENDER_SCALE, 0, 0);

      // Posição do motor em coordenadas lógicas (origem do desenho; todas as peças são relativas
      // a xCenter/yCenter e multiplicadas por `scale`). Valores que centralizam o motor no Canvas.
      const ENGINE_X_CENTER = 241;
      const ENGINE_Y_CENTER = 286;
      let xCenter = ENGINE_X_CENTER;
      let yCenter = ENGINE_Y_CENTER;

      // =====================================================================================
      // BLOCO 3 — VELOCIDADE DA ANIMAÇÃO (omega) E CONDIÇÕES INICIAIS
      // =====================================================================================
      //*********************************
      // Variaveis Inciais e Constantes para o Cálculo e Desenho do Ciclo Stirling
      //*********************************
      // omega = incremento angular POR QUADRO (rad/quadro), não rad/s. É uma regra
      // visual/didática (não uma lei física): quanto maior ΔT = Th - Tc, mais rápida a animação.
      //   ΔT <= 100 K -> OMEGA_SLOW (0.01) | ΔT = 900 K -> OMEGA_NORMAL (0.05) | ΔT >= 1800 K -> OMEGA_FAST (0.09)
      //   Entre as âncoras a velocidade varia continuamente (interpolação linear), então cada
      //   passo de 20 K em Th ou Tc altera a velocidade de forma perceptível.
      const OMEGA_SLOW = 0.01;
      const OMEGA_NORMAL = 0.05;
      const OMEGA_FAST = 0.09;
      const DELTA_T_SLOW = 100; // K
      const DELTA_T_NORMAL = 900; // K (condição inicial de referência)
      const DELTA_T_FAST = 1800; // K
      /**
       * Velocidade angular visual da animação (rad por QUADRO) em função de ΔT = Th − Tc.
       * Interpolação linear por partes entre as âncoras OMEGA_SLOW (ΔT ≤ 100 K), OMEGA_NORMAL (900 K)
       * e OMEGA_FAST (ΔT ≥ 1800 K). Não é grandeza física: apenas regra didática.
       * @param {number} deltaT diferença de temperatura entre as fontes (K)
       * @returns {number} incremento angular por quadro (rad); OMEGA_NORMAL se a entrada for inválida
       */
      function getOmegaForDeltaT(deltaT) {
        if (!Number.isFinite(deltaT)) return OMEGA_NORMAL; // entrada inválida: valor padrão
        if (deltaT <= DELTA_T_SLOW) return OMEGA_SLOW;
        if (deltaT >= DELTA_T_FAST) return OMEGA_FAST;
        if (deltaT <= DELTA_T_NORMAL) {
          const u = (deltaT - DELTA_T_SLOW) / (DELTA_T_NORMAL - DELTA_T_SLOW);
          return OMEGA_SLOW + (OMEGA_NORMAL - OMEGA_SLOW) * u;
        }
        const u = (deltaT - DELTA_T_NORMAL) / (DELTA_T_FAST - DELTA_T_NORMAL);
        return OMEGA_NORMAL + (OMEGA_FAST - OMEGA_NORMAL) * u;
      }
      let omega = OMEGA_NORMAL;

      // Constantes físicas e condição de carga do modelo de referência (Arquivo 1), em unidades SI.
      // Observação: n·R = P0·V0/T0 não depende do valor de R; só o n exibido depende.
      const R = 8.314462; // J/(mol·K)
      const P0 = 101325; // Pa — pressão atmosférica da condição de carga
      const T0 = 298.15; // K — temperatura ambiente da condição de carga
      let n = 0; // mol — calculado por calculateInitialCharge() a partir da condição de carga

      let Tc = 400;
      let Th = 660;

      // =====================================================================================
      // BLOCO 4 — MODELO TERMODINÂMICO (ciclo ideal e modelo de Schmidt)
      // =====================================================================================
      // Ordem de dependência: geometria → volumes varridos → carga (n) → estados e curvas do ciclo ideal
      // → curva de Schmidt → isotermas de referência → trabalhos. Tudo é refeito por recalculateModel().
      //*********************************
      // MODELO TERMODINÂMICO (incorporado do modelo de referência — Arquivo 1)
      //*********************************
      // Substitui o modelo anterior (geometria lida do desenho do Canvas + calibração didática
      // de 250 L). Unidades: volumes em cm³, pressões calculadas em Pa e plotadas em kPa,
      // temperaturas em K, quantidade de matéria em mol, ângulos em radianos, trabalho em J.
      //
      // Referência angular única: theta = variável `angle` da animação. O mecanismo desenhado
      // concorda com as equações de volume abaixo SEM deslocamento de fase:
      //   deslocador (angle_one_engine = theta + π/2): espaço quente ∝ (1 − cos θ); frio ∝ (1 + cos θ)
      //   potência   (angle_two_engine = theta − π/2): volume ∝ (1 − cos(θ − dx)), com dx = π/2
      // ================================================================================

      // Geometria (mantida conforme os dados originais do modelo de referência)
      const De = 19.8; // cm — diâmetro do espaço de expansão
      const Se = 2; // cm — curso do deslocador
      const Vde = 1.1945; // cm³ — volume morto de expansão
      const Vdc = 0.01789; // cm³ — volume morto de compressão
      const dx = (90 * Math.PI) / 180; // rad — defasagem entre deslocador e pistão de potência
      const x0 = 0; // rad — posição angular da condição de carga e início da curva de Schmidt
      const SCHMIDT_POINTS = 720; // intervalos angulares da curva fechada de Schmidt
      const IDEAL_SAMPLES = 120; // intervalos das isotérmicas do ciclo ideal

      // Parâmetros variáveis (valores iniciais do modelo de referência)
      let Dc = 7; // cm — diâmetro do cilindro de compressão
      let Sc = 4; // cm — curso do pistão de potência

      let Vse, Vsc, V0; // cm³: volumes varridos (expansão, compressão) e volume na condição de carga
      let V1, V2, V3, V4; // cm³: volumes dos 4 estados do ciclo ideal
      let P1, P2, P3, P4; // Pa: pressões dos 4 estados do ciclo ideal
      let dataPh, dataPc, dataLine14, dataLine23, dataSchmidt; // séries [V (cm³), P (kPa)]
      let dataPh_gray, dataPc_gray; // isotermas de referência (Th e Tc)
      let w12, w34, w; // J: trabalhos do ciclo ideal
      let cycleWorkModel = 0; // J: ∮ P dV da curva de Schmidt (trabalho do MODELO do motor)

      // Margem visual dos eixos (fração de V2 − V1). Não entra em nenhum cálculo: só evita que as
      // isocóricas e o marcador fiquem cortados sobre a borda da área do gráfico.
      const AXIS_MARGIN_FRAC = 0.05;

      /**
       * Volumes varridos pelos dois êmbolos: Vse = π·De²/4·Se (deslocador, expansão) e
       * Vsc = π·Dc²/4·Sc (pistão de potência, compressão). Lê De, Se, Dc, Sc (cm); grava Vse, Vsc (cm³).
       */
      // 3. Geometria e volumes instantâneos
      function calculateSweptVolumes() {
        Vse = ((Math.PI * De ** 2) / 4) * Se;
        Vsc = ((Math.PI * Dc ** 2) / 4) * Sc;
      }

      /**
       * Volumes instantâneos em função do ângulo θ, com defasagem dx entre os êmbolos:
       *   Ve = Vse/2·(1 − cos θ) + Vde                             (expansão, quente)
       *   Vc = Vse/2·(1 + cos θ) + Vsc/2·(1 − cos(θ − dx)) + Vdc   (compressão, fria)
       * @param {number} theta ângulo de fase (rad)
       * @returns {{Ve:number, Vc:number, Vtotal:number}} volumes em cm³
       */
      // Ve: espaço de expansão (quente, a Th). Vc: espaço de compressão (frio, a Tc).
      function calculateVolumes(theta) {
        const Ve = (Vse / 2) * (1 - Math.cos(theta)) + Vde;
        const Vc =
          (Vse / 2) * (1 + Math.cos(theta)) +
          (Vsc / 2) * (1 - Math.cos(theta - dx)) +
          Vdc;

        return { Ve, Vc, Vtotal: Ve + Vc };
      }

      /**
       * Condição de carga: V0 = Vtotal(x0) e n = P0·V0/(R·T0) (V0 convertido para m³).
       * Grava V0 (cm³) e n (mol). Não depende de Th e Tc.
       */
      // 4. Condição inicial e quantidade de gás: n = P0·V0/(R·T0), com V0 em m³
      function calculateInitialCharge() {
        V0 = calculateVolumes(x0).Vtotal; // cm³
        n = (P0 * V0 * 1e-6) / (R * T0);
      }

      /**
       * Gás ideal: P = n·R·T/V.
       * @param {number} temperature temperatura (K)
       * @param {number} volumeCm3 volume (cm³)
       * @returns {number} pressão (Pa)
       */
      // 5. Pressão dos modelos ideal e Schmidt (resultados em Pa)
      function calculatePressureIdeal(temperature, volumeCm3) {
        const volumeM3 = volumeCm3 * 1e-6;
        return (n * R * temperature) / volumeM3;
      }

      /**
       * Modelo isotérmico de Schmidt: P = n·R / (Ve/Th + Vc/Tc), com Ve e Vc em m³.
       * @param {number} theta ângulo de fase (rad)
       * @returns {{pressure:number, volume:number}} pressão (Pa) e volume total (cm³)
       */
      function calculatePressureSchmidt(theta) {
        const volumes = calculateVolumes(theta);
        const VeM3 = volumes.Ve * 1e-6;
        const VcM3 = volumes.Vc * 1e-6;

        const pressure = (n * R) / (VeM3 / Th + VcM3 / Tc);

        return { pressure, volume: volumes.Vtotal };
      }

      /**
       * Amostra uma isoterma P = n·R·T/V entre dois volumes, com `points` intervalos.
       * @returns {Array<[number, number]>} pares [V (cm³), P (kPa)]
       */
      // 6. Estados e curvas do ciclo ideal
      function generateIsothermalCurve(temperature, startVolume, endVolume, points = IDEAL_SAMPLES) {
        const data = [];
        for (let i = 0; i <= points; i++) {
          const volume = startVolume + (endVolume - startVolume) * (i / points);
          const pressure = calculatePressureIdeal(temperature, volume);
          data.push([volume, pressure / 1000]); // cm³, kPa
        }
        return data;
      }

      /**
       * Define os 4 estados do ciclo ideal (V1…V4, P1…P4) e gera as séries do gráfico:
       * dataPh (1→2, isoterma a Th), dataLine23 (2→3, isocórica), dataPc (3→4, isoterma a Tc),
       * dataLine14 (4→1, isocórica). Depende de Th, Tc, n e dos volumes varridos.
       */
      // Numeração dos estados (igual à Figura 4 do TCC, Çengel e Boles): 1 -> 2 expansão isotérmica (Th),
      // 2 -> 3 resfriamento isocórico, 3 -> 4 compressão isotérmica (Tc), 4 -> 1 aquecimento isocórico.
      function generateIdealCycle() {
        V1 = Vse + Vde + Vdc; // volume mínimo
        V2 = V1 + Vsc; // volume máximo
        V3 = V2;
        V4 = V1;

        P1 = calculatePressureIdeal(Th, V1);
        P2 = calculatePressureIdeal(Th, V2);
        P3 = calculatePressureIdeal(Tc, V3);
        P4 = calculatePressureIdeal(Tc, V4);

        dataPh = generateIsothermalCurve(Th, V1, V2);
        dataLine23 = [
          [V2, P2 / 1000],
          [V3, P3 / 1000],
        ];
        dataPc = generateIsothermalCurve(Tc, V3, V4);
        dataLine14 = [
          [V4, P4 / 1000],
          [V1, P1 / 1000],
        ];
      }

      /**
       * Faixa visível do eixo de volume do gráfico: [V1 − m, V2 + m], m = AXIS_MARGIN_FRAC·(V2 − V1).
       * @returns {{min:number, max:number}} limites em cm³ (a margem é apenas visual)
       */
      // Faixa de volume do eixo horizontal (V1 e V2 são também V_min e V_max da curva de Schmidt)
      function getAxisRange() {
        const margin = (V2 - V1) * AXIS_MARGIN_FRAC;
        return { min: V1 - margin, max: V2 + margin };
      }

      /**
       * Gera as isotermas cinza de referência (Th e Tc) sobre a faixa visível: dataPh_gray e dataPc_gray
       * (séries 0 e 1 do gráfico).
       */
      // Isotermas de referência (cinza) de Th e Tc sobre a faixa visível do eixo de volume
      function generateReferenceIsotherms() {
        const range = getAxisRange();
        dataPh_gray = generateIsothermalCurve(Th, range.min, range.max);
        dataPc_gray = generateIsothermalCurve(Tc, range.min, range.max);
      }

      /**
       * Curva fechada de Schmidt: P(θ) e V(θ) para θ de x0 a x0 + 2π em SCHMIDT_POINTS intervalos.
       * @returns {Array<[number, number]>} pares [V (cm³), P (kPa)]; o último ponto repete o primeiro
       */
      // 7. Curva fechada do ciclo de Schmidt (uma volta: theta de x0 a x0 + 2π; o último ponto repete o primeiro)
      function generateSchmidtCurve(points = SCHMIDT_POINTS) {
        const data = [];
        for (let i = 0; i <= points; i++) {
          const theta = x0 + (2 * Math.PI * i) / points;
          const result = calculatePressureSchmidt(theta);
          data.push([result.volume, result.pressure / 1000]); // cm³, kPa
        }
        return data;
      }

      /**
       * Trabalho líquido do ciclo ideal (J): W = W12 + W34 (as isocóricas não realizam trabalho).
       * Grava w12 (expansão a Th) e w34 (compressão a Tc).
       * @returns {number} trabalho por ciclo (J)
       */
      // 8. Trabalhos (J)
      // Ideal: fórmula fechada das duas isotérmicas (as isocóricas não realizam trabalho),
      //   W = n·R·Th·ln(V2/V1) + n·R·Tc·ln(V4/V3).
      // A razão de volumes é adimensional: n [mol]·R [J/(mol·K)]·T [K] já resulta em J.
      function calculateIdealWork() {
        w12 = n * R * Th * Math.log(V2 / V1);
        w34 = n * R * Tc * Math.log(V4 / V3);
        return w12 + w34;
      }

      /**
       * Trabalho do motor no modelo de Schmidt: ∮ P dV pela regra do trapézio sobre a curva fechada.
       * @param {Array<[number, number]>} data pares [V (cm³), P (kPa)]
       * @returns {number} trabalho por ciclo (J); positivo = percurso horário no diagrama P-V
       */
      // Motor (modelo de Schmidt): ∮ P dV pela regra do trapézio sobre a curva fechada.
      // V em cm³ e P em kPa: 1 kPa·cm³ = 10³ Pa · 10⁻⁶ m³ = 10⁻³ J. Positivo = percurso horário no P-V.
      function calculateSchmidtWork(data) {
        let W = 0;
        for (let i = 0; i < data.length - 1; i++) {
          W += ((data[i][1] + data[i + 1][1]) / 2) * (data[i + 1][0] - data[i][0]);
        }
        return W * 1e-3;
      }

      /**
       * Recalcula todo o modelo na ordem de dependência (volumes varridos → carga n → ciclo ideal →
       * curva de Schmidt → isotermas → trabalhos). Chamada na inicialização e a cada mudança de Th/Tc.
       */
      // 9. Recálculo completo (n, ciclo ideal, curva de Schmidt, isotermas e trabalhos).
      // Depende de Th e Tc, por isso é refeito sempre que uma temperatura muda.
      function recalculateModel() {
        calculateSweptVolumes();
        calculateInitialCharge();
        generateIdealCycle();
        dataSchmidt = generateSchmidtCurve();
        generateReferenceIsotherms();
        w = calculateIdealWork();
        cycleWorkModel = calculateSchmidtWork(dataSchmidt);
      }

      /**
       * Estado do gás no ângulo θ pelo modelo de Schmidt, com T efetiva = P·V/(n·R).
       * Disponível para análise; o marcador do gráfico usa calculateIdealCycleState().
       * @returns {{theta:number, V:number, P:number, T:number}} V (cm³), P (kPa), T (K)
       */
      // Estado do gás de trabalho em theta, usado pelo marcador do gráfico e pela coloração térmica.
      // V em cm³, P em kPa (absoluta), T em K (temperatura efetiva T = P·V/(n·R), com Tc <= T <= Th).
      function calculateThermodynamicState(theta) {
        const s = calculatePressureSchmidt(theta);
        return {
          theta,
          V: s.volume,
          P: s.pressure / 1000,
          T: (s.pressure * s.volume * 1e-6) / (n * R),
        };
      }

      /**
       * COMUNICAÇÃO COM A UI: escreve W_ciclo,ideal (#work) e W_motor,modelo (#workModel), em J, com
       * WORK_DECIMALS casas decimais. Chamada após cada recálculo do modelo.
       */
      // Trabalhos exibidos na interface (J). O gás do modelo é pequeno (~10⁻⁴ mol, ~9 cm³),
