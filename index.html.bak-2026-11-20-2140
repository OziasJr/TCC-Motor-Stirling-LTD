        console.log("V0 (volume na posição x0):", V0, "cm³");
        console.groupEnd();

        console.group("Parâmetros termodinâmicos");
        console.log("R:", R, "J/(mol·K)");
        console.log("P0:", P0, "Pa | T0:", T0, "K");
        console.log("Th:", Th, "K | Tc:", Tc, "K");
        console.log("n (quantidade de matéria recalculada):", n, "mol");
        console.groupEnd();

        console.group("Coeficientes do modelo de Schmidt  P = n·R / (Ve/Th + Vc/Tc)");
        console.log("n·R:", n * R, "J/K");
