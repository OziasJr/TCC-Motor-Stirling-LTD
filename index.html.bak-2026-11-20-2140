        console.log("Vse/2:", Vse / 2, "cm³ | Vsc/2:", Vsc / 2, "cm³");
        console.groupEnd();

        console.group("Pressões calculadas");
        console.log("P1 (Th, V1):", kPa(P1), "kPa");
        console.log("P2 (Th, V2):", kPa(P2), "kPa");
        console.log("P3 (Tc, V3):", kPa(P3), "kPa");
        console.log("P4 (Tc, V4):", kPa(P4), "kPa");
        console.log("Schmidt, mínima:", Math.min(...pSchmidt), "kPa | máxima:", Math.max(...pSchmidt), "kPa");
        console.groupEnd();

        console.group("Trabalho ideal (por ciclo)");
        console.log("W12 (expansão isotérmica, Th):", w12, "J");
        console.log("W34 (compressão isotérmica, Tc):", w34, "J");
        console.log("W ideal = W12 + W34:", w, "J");
        console.groupEnd();

        console.group("Trabalho real (motor, modelo de Schmidt)");
        console.log("W Schmidt = ∮ P dV:", cycleWorkModel, "J");
        console.log("W Schmidt / W ideal:", (cycleWorkModel / w) * 100, "%");
        console.groupEnd();

        console.groupEnd();
      }

      // INICIALIZAÇÃO DO MODELO: velocidade inicial coerente com ΔT, primeiro cálculo completo,
