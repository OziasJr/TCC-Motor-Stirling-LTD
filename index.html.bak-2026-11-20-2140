      // ---- Marcador "Estado Atual" e ciclo ideal: índices das séries e funções de interpolação ----
      // SINCRONIZAÇÃO GRÁFICO x MOTOR: o motor e o gráfico compartilham a MESMA fase `angle_six_engine`
      // (ângulo mestre; `angle` e os demais ângulos são derivados dele por setCycleAngle()).
      // Em cada quadro: (1) o ângulo é atualizado em draw(); (2) calculateIdealCycleState(angle_six_engine)
      // obtém (V, P) sobre as curvas do ciclo ideal; (3) o marcador é posto
      // em (V, P) desse estado; (4) o motor é desenhado com o mesmo ângulo. O volume V do eixo
      // horizontal é o volume TOTAL do gás (expansão + compressão, em cm³), e não a posição de um pistão.
      // A linha de Schmidt continua sendo desenhada (generateSchmidtCurve), mas o marcador não a percorre mais.
      // Índices das séries no array "series" do gráfico (ajuste se a posição mudar)
      const CYCLE_POINT_SERIES_INDEX = 6;
      const CYCLE_LOOP_SERIES_INDEX = 7;

      // Posição [V, P] a uma fração f (0 a 1) ao longo de uma polilinha de pontos [V, P]. Usa os próprios
      // pontos plotados (dataPh, dataPc, dataLine23, dataLine14), com interpolação linear entre vizinhos:
      // o resultado fica exatamente sobre o segmento desenhado.
      /**
       * Ponto [V, P] na fração f (0 a 1) de uma polilinha, por interpolação linear entre vizinhos;
       * o resultado cai exatamente sobre o segmento desenhado.
       * @param {Array<[number, number]>} data pontos [V (cm³), P (kPa)]
       * @param {number} f fração do percurso (limitada a [0, 1])
       * @returns {[number, number]} [V, P]
       */
      function pointOnPolyline(data, f) {
        const x = Math.min(1, Math.max(0, f)) * (data.length - 1);
        const i = Math.min(Math.floor(x), data.length - 2);
        const u = x - i;
        return [
          data[i][0] + (data[i + 1][0] - data[i][0]) * u,
          data[i][1] + (data[i + 1][1] - data[i][1]) * u,
        ];
      }

      // Estado [V, P] do ponto atual sobre o CICLO IDEAL, em função de angle_six_engine (θ). Cada quarto
      // de volta percorre uma curva ideal, na ordem e no sentido em que foram geradas (estados 1->2->3->4->1):
      //   π    -> 3π/2: expansão isotérmica (Th), dataPh     (estado 1 -> 2)
      //   3π/2 -> 2π:   resfriamento isocórico,   dataLine23 (estado 2 -> 3)
      //   0    -> π/2:  compressão isotérmica (Tc), dataPc   (estado 3 -> 4)
      //   π/2  -> π:    aquecimento isocórico,    dataLine14 (estado 4 -> 1)
      // A fração f varia linearmente com θ em cada fase; nas junções f = 1 de uma fase e f = 0 da seguinte
      // coincidem no mesmo estado, então não há saltos.
      /**
       * Estado [V, P] do ponto atual sobre o CICLO IDEAL em função de θ: cada quarto de volta percorre
       * uma das quatro curvas (dataPc, dataLine14, dataPh, dataLine23) com fração linear em θ.
       * @param {number} theta ângulo de fase (rad), normalizado internamente para [0, 2π)
       * @returns {{V:number, P:number}} volume (cm³) e pressão (kPa)
       */
      function calculateIdealCycleState(theta) {
        const t = normalizeAngle(theta);
        const quarter = Math.PI / 2;
        let data, f;
        if (t >= Math.PI && t < 1.5 * Math.PI) {
          data = dataPh;
          f = (t - Math.PI) / quarter;
        } else if (t >= 1.5 * Math.PI) {
          data = dataLine23;
          f = (t - 1.5 * Math.PI) / quarter;
        } else if (t < quarter) {
          data = dataPc;
          f = t / quarter;
        } else {
          data = dataLine14;
          f = (t - quarter) / quarter;
        }
        const [V, P] = pointOnPolyline(data, f);
        return { V, P };
      }

      // Atualiza o marcador "Estado Atual" sobre as curvas ideais, a partir de angle_six_engine (mesmo ângulo do desenho).
      /**
       * ATUALIZAÇÃO DO HIGHCHARTS: move o marcador "Estado Atual" (série 6) para o estado ideal
       * correspondente a angle_six_engine (+ MARKER_PHASE_OFFSET). Chamada a cada quadro de draw().
       */
      function updateCyclePointMarker() {
        const state = calculateIdealCycleState(angle_six_engine + MARKER_PHASE_OFFSET);
        chart.series[CYCLE_POINT_SERIES_INDEX].setData([[state.V, state.P]], true, false);
      }

      // ===================================================================================
      // COR DA ÁREA INTERNA (ILUSTRATIVA), definida somente por angle_six_engine:
      //   metade de π/2 a 3π/2 tende ao vermelho; a outra metade (por 2π/0), ao azul.
      // A cor clareia até o tom claro em π/2 e 3π/2 e a outra cor se intensifica a partir dele.
      // Acompanha play, step, rewind, reset e velocidade.
      // ===================================================================================
      const FLUID_RED = [255, 64, 64];
      const FLUID_BLUE = [64, 64, 255];
      const FLUID_FADE = [200, 200, 200]; // tom claro intermediário do fade
      // Fade contínuo e simétrico em todo o ciclo, sem trecho de cor sólida estendido:
      //   θ = π   -> vermelho sólido  | θ = π/2 e 3π/2 -> tom bem claro (branco)  | θ = 0 -> azul sólido
      //   vermelho -> clareia -> azul  (π -> 3π/2 -> 2π/0)  e  azul -> clareia -> vermelho  (0 -> π/2 -> π)
      // A intensidade da cor segue smoothstep(|−cos θ|): derivada nula nos extremos (cor sólida) e no
      // ponto claro, então não há "quina" nem salto, nos dois sentidos de rotação (play/rewind).
      /**
       * Cor da área interna do motor (ilustrativa), apenas em função de θ: vermelho sólido em π,
       * azul sólido em 0 e tom claro em π/2 e 3π/2 (smoothstep, sem saltos nos dois sentidos).
       * @param {number} theta ângulo mestre (rad)
       * @returns {string} cor CSS "rgb(r, g, b)"
       */
      function getFluidColor(theta) {
        const u = -Math.cos(theta); // +1: vermelho sólido | 0: claro (π/2, 3π/2) | −1: azul sólido
        const k = Math.abs(u); // 0 (claro) ... 1 (cor sólida)
        const e = k * k * (3 - 2 * k); // smoothstep
        const base = u >= 0 ? FLUID_RED : FLUID_BLUE;
        const c = FLUID_FADE.map((f, i) => Math.round(f + (base[i] - f) * e));
        return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
      }

      // =====================================================================================
      // BLOCO 7 — ÂNGULO MESTRE E FASES DO CICLO
      // =====================================================================================
      // ===================================================================================
      // ÂNGULO MESTRE: angle_six_engine determina o ponto do gráfico e todas as peças do motor.
      //   π    -> 3π/2: expansão isotérmica     | 3π/2 -> 2π (0): resfriamento isocórico
      //   0    -> π/2 : compressão isotérmica   | π/2  -> π     : aquecimento isocórico
      // As defasagens das demais peças são as mesmas das condições iniciais originais.
      // ===================================================================================
      const TWO_PI = Math.PI * 2;
      /**
       * Reduz um ângulo ao intervalo [0, 2π), inclusive para valores negativos (rewind).
       * @param {number} a ângulo (rad)
       * @returns {number} ângulo normalizado (rad)
       */
      function normalizeAngle(a) {
        return ((a % TWO_PI) + TWO_PI) % TWO_PI; // sempre em [0, 2π), inclusive ao retroceder
      }
      /**
       * Define o ângulo mestre (angle_six_engine) e deriva os demais, com as defasagens do mecanismo:
       * angle (volante) = θ; angle_one_engine e angle_five_engine = θ + π/2 (deslocador e sua manivela);
       * angle_two_engine = θ − π/2 (pistão de potência). Única porta de entrada para mudar a fase.
       * @param {number} theta novo ângulo mestre (rad)
       */
      function setCycleAngle(theta) {
        angle_six_engine = normalizeAngle(theta);
        angle = angle_six_engine;
        angle_one_engine = normalizeAngle(angle_six_engine + Math.PI / 2);
        angle_two_engine = normalizeAngle(angle_six_engine - Math.PI / 2);
        angle_five_engine = normalizeAngle(angle_six_engine + Math.PI / 2);
      }
      /**
       * Nome da fase do ciclo para um ângulo θ. Não é chamada pela interface atual; fica disponível
       * para rótulos ou depuração.
       * @returns {string} "Expansão isotérmica" | "Resfriamento isocórico" | "Compressão isotérmica" | "Aquecimento isocórico"
       */
      function getCyclePhase(theta) {
        const t = normalizeAngle(theta);
        if (t >= Math.PI && t < 1.5 * Math.PI) return "Expansão isotérmica";
        if (t >= 1.5 * Math.PI) return "Resfriamento isocórico";
        if (t < Math.PI / 2) return "Compressão isotérmica";
        return "Aquecimento isocórico";
      }

      // =====================================================================================
      // BLOCO 8 — ATUALIZAÇÃO DO MODELO E DO GRÁFICO
      // =====================================================================================
      //*********************************
      // Função que Atualiza os Cálculos em Tempo Real a Cada Modificação e Consequentemente o Gráfico
      //*********************************
      /**
       * Chamada quando Th ou Tc mudam (botões de temperatura e reload): (1) recalcula o modelo e as
       * leituras de trabalho; (2) atualiza omega pela nova ΔT; (3) ajusta os extremos dos eixos;
       * (4) substitui os dados das séries 0–5 e 7 sem redesenhar e renomeia as isotermas cinza;
       * (5) redesenha uma única vez, reposiciona o marcador e escreve o resumo no console.
       */
      function updateChart() {
        // Th/Tc mudaram: recalcula n, ciclo ideal, curva de Schmidt, isotermas e trabalhos
        recalculateModel();
        updateWorkDisplay();

        omega = getOmegaForDeltaT(Th - Tc);

        const axisRange = getAxisRange();
        chart.xAxis[0].setExtremes(axisRange.min, axisRange.max, false);
        chart.yAxis[0].setExtremes(null, P1 / 1000 + 50, false);

        chart.series[0].setData(dataPh_gray, false);
        chart.series[1].setData(dataPc_gray, false);
        chart.series[2].setData(dataPh, false);
        chart.series[3].setData(dataPc, false);
        chart.series[4].setData(dataLine14, false);
        chart.series[5].setData(dataLine23, false);
        chart.series[CYCLE_LOOP_SERIES_INDEX].setData(dataSchmidt, false);

        chart.series[0].update({ name: `${Th} K` }, false);
        chart.series[1].update({ name: `${Tc} K` }, false);

        chart.redraw();
        updateCyclePointMarker();
        logModelSummary();
      }

      // =====================================================================================
      // BLOCO 9 — ANIMAÇÃO DO CANVAS
      // =====================================================================================
      // Estado da animação: isPlaying (play/pause), animation (id do requestAnimationFrame), os ângulos
      // do mecanismo (derivados de angle_six_engine por setCycleAngle) e a escala dos desenhos.
      //*********************************
      // Variáveis Inciais Referentes ao Motor Stirling (Omega, Angulos Inciais, Escala e ect)
      //*********************************
      let isPlaying = false; // controla play/pause
